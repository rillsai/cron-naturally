{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "assist": { "enabled": false },
  "files": {
    "includes": ["**", "!dist", "!docs/cron-naturally.mjs", "!**/*.min.js"]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "lineEnding": "lf",
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "double"
    }
  },
  "json": {
    "formatter": { "trailingCommas": "none" }
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  }
}
